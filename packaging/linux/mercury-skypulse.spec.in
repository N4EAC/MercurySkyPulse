%global debug_package %{nil}
# PySide6's optional private TIFF image plugin targets libtiff.so.5. Fedora's
# current libtiff ABI is newer; do not turn that optional backend into a hard
# application dependency. Other generated RPM requirements remain enabled.
%global __requires_exclude ^libtiff[.]so[.]5.*$

Name:           mercury-skypulse
Version:        @RPM_VERSION@
Release:        1%{?dist}
Summary:        Mercury-based amateur-radio digital communications station
License:        GPL-3.0-or-later
URL:            https://github.com/N4EAC/MercurySkyPulse
Source0:        mercury-skypulse-@VERSION@.tar.gz
BuildArch:      x86_64
Requires:       glibc, mesa-libEGL, mesa-libGL, libxkbcommon-x11, alsa-lib, pulseaudio-libs, pipewire-libs, hamlib

%description
Mercury SkyPulse provides chat, short voice messages, beacon, ping, file transfer,
BBS, location, reporting, and station controls through a bundled Mercury modem runtime.

%prep
%setup -q -n mercury-skypulse-@VERSION@

%build

%install
mkdir -p %{buildroot}/opt/mercuryskypulse
cp -a app/. %{buildroot}/opt/mercuryskypulse/
mkdir -p %{buildroot}%{_bindir}
ln -s ../../opt/mercuryskypulse/MercurySkyPulse %{buildroot}%{_bindir}/mercury-skypulse
mkdir -p %{buildroot}%{_datadir}/applications
install -m 0644 mercuryskypulse.desktop %{buildroot}%{_datadir}/applications/mercuryskypulse.desktop
mkdir -p %{buildroot}%{_datadir}/icons/hicolor/256x256/apps
install -m 0644 mercuryskypulse.png %{buildroot}%{_datadir}/icons/hicolor/256x256/apps/mercuryskypulse.png

%files
/opt/mercuryskypulse
%{_bindir}/mercury-skypulse
%{_datadir}/applications/mercuryskypulse.desktop
%{_datadir}/icons/hicolor/256x256/apps/mercuryskypulse.png

%changelog
* Thu Aug 13 2026 Mercury SkyPulse contributors - @RPM_VERSION@-1
- Initial Fedora engineering package
